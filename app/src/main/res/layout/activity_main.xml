<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VLESS Minimal VPN"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#212529"
        android:layout_marginBottom="32dp"/>

    <EditText
       android:id="@+id/et_ip"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:hint="Server IP"
       android:textColor="#333333" 
       android:textColorHint="#888888" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        
        <EditText
            android:id="@+id/et_port"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Port"
            android:inputType="number"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"/>
            
        <Button
            android:id="@+id/btn_fixed_port"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Set Fixed 2096"
            android:layout_marginStart="8dp"
            android:backgroundTint="#6C757D"/>
    </LinearLayout>

    <EditText
        android:id="@+id/et_uuid"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="User UUID"
        android:background="@android:drawable/editbox_background"
        android:padding="10dp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="START VPN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#198754"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="STOP VPN"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#DC3545"
        android:layout_marginBottom="32dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DEE2E6"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btn_check_traffic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check Remaining Traffic"
        android:backgroundTint="#0D6EFD"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_traffic_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Traffic Status: Not Checked"
        android:textSize="16sp"
        android:textColor="#495057"
        android:textStyle="italic"/>
</LinearLayout>
